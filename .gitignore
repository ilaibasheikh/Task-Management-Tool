## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml
# ========================================
# React / Vite / TypeScript
# ========================================
node_modules/
dist/
build/
.vite/
vite.svg

# Environment files
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# Keep example env file
!.env.example

# ========================================
# Coverage Reports
# ========================================
coverage/
coverage-reports/
TestResults/
*.coverage
*.coveragexml
coverage.opencover.xml

# ========================================
# SonarQube
# ========================================
.sonarqube/
.scannerwork/

# ========================================
# Serilog Logs
# ========================================
Logs/
*.log

# ========================================
# Visual Studio
# ========================================
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/

# ========================================
# SQL Server LocalDB
# ========================================
*.mdf
*.ldf

# ========================================
# OS Files
# ========================================
.DS_Store
Thumbs.db
Desktop.ini

# ========================================
# Package Managers
# ========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================================
# Temporary Files
# ========================================
tmp/
temp/
*.tmp

# ========================================
# Generated Certificates / Secrets
# ========================================
secrets.json
appsettings.Development.local.json
appsettings.Local.json

# ========================================
# Publish Output
# ========================================
publish/
out/

# ========================================
# EF Core Design-time Artifacts
# ========================================
*.dbmdl